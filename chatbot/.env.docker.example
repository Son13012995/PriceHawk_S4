# .env dành cho chatbot khi chạy trong Docker
# DB_HOST = tên service MySQL trong docker network (không phải localhost)
GOOGLE_API_KEY=your_google_api_key_here
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=pricecomparison
CHATBOT_PORT=8000
FRONTEND_URL=http://localhost:3000
