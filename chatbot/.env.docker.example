# Chatbot Service — Docker Runtime Environment Variables
# Copy this file to .env.docker and fill in real values
# Used by docker-compose when running the chatbot container
# NOTE: DB_HOST=mysql (Docker service name, NOT localhost)

# ── LLM ─────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── MySQL ────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=pricecomparison

# ── FastAPI ──────────────────────────────────────
CHATBOT_PORT=8000

# ── CORS (Next.js frontend) ──────────────────────
FRONTEND_URL=http://localhost:3000

# ── SearxNG (Internet Agent) ─────────────────────
# In Docker network, SearxNG is reachable via its service name
SEARXNG_URL=http://searxng:8080
