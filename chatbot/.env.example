# Chatbot Service Environment Variables
# Copy file này thành .env và điền giá trị thực

# ── Gemini API ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── MySQL (dùng chung với Next.js app) ──────────────────────────────────────
# Nếu chạy local dev (Docker expose port 3307):
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=pricecomparison

# ── FastAPI Service ──────────────────────────────────────────────────────────
CHATBOT_PORT=8000

# ── CORS (Next.js frontend) ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
