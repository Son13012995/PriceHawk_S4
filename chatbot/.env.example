# Chatbot Service — Local Dev Environment Variables
# Copy this file to .env and fill in real values
# Used when running the chatbot directly (not via Docker)

# ── LLM ─────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── MySQL ────────────────────────────────────────
# Docker exposes MySQL on port 3307 to the host
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=pricecomparison

# ── FastAPI ──────────────────────────────────────
CHATBOT_PORT=8000

# ── CORS (Next.js frontend) ──────────────────────
FRONTEND_URL=http://localhost:3000

# ── SearxNG (Internet Agent) ─────────────────────
# When running locally, SearxNG is at localhost:8080
SEARXNG_URL=http://localhost:8080
