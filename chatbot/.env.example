# Chatbot Service Environment Variables
# Copy this file to .env and fill real values

# LLM keys
GROQ_API_KEY=your_groq_api_key_here

# MySQL (local dev, Docker exposes 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=pricecomparison

# FastAPI
CHATBOT_PORT=8000

# CORS (Next.js frontend)
FRONTEND_URL=http://localhost:3000

# SearxNG (optional for internet agent)
SEARXNG_URL=http://localhost:8083
