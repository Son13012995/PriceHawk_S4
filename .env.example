# Local MySQL (Docker exposes 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=pricecomparison

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# NextAuth (required)
NEXTAUTH_SECRET=your_random_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Chatbot FastAPI Service (local dev on port 8000)
CHATBOT_SERVICE_URL=http://localhost:8000