FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    cron \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app/price-hawk

# Copy requirements đúng path
COPY price-hawk/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir scrapy pymysql python-dotenv && \
    if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi

# Copy project đúng thư mục
COPY price-hawk/ .

# Create logs directory
RUN mkdir -p logs data

# Make run script executable
RUN chmod +x run_crawler.sh

# Setup cron
RUN echo "*/5 * * * * cd /app/price-hawk && ./run_crawler.sh >> /app/price-hawk/logs/cron.log 2>&1" > /etc/cron.d/crawler-cron && \
    chmod 0644 /etc/cron.d/crawler-cron && \
    crontab /etc/cron.d/crawler-cron

# Health check
HEALTHCHECK --interval=5m --timeout=30s --start-period=10s --retries=3 \
    CMD ["sh", "-c", "test -f /app/price-hawk/logs/cron.log || test -n \"$(ls -A /app/price-hawk/logs/crawler_*.log 2>/dev/null)\""]

# Start cron
CMD ["sh", "-c", "printenv > /etc/environment && cron -f"]